{
  "name": "seraph-zero-interface",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build:core && vite",
    "build": "npm run build:core && npm run build:ui",
    "preview": "vite preview --outDir build",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @seraph-zero/core",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "npm test --workspace @seraph-zero/core",
    "check:contracts": "npm run check:contracts --workspace @seraph-zero/core",
    "build:core": "npm run build --workspace @seraph-zero/core",
    "build:ui": "tsc && vite build --outDir build",
    "test:ui": "tsc && node --test tests/*.test.mjs",
    "validate:nodes": "node packages/core/scripts/validate.mjs",
    "export:public": "node packages/core/scripts/export.mjs",
    "generate:contracts": "npm run generate:contracts --workspace @seraph-zero/core"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "@seraph-zero/core": "0.1.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
