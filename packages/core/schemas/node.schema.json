    },
    {
      "$ref": "outcome.schema.json"
    },
    {
      "$ref": "bet.schema.json"
    },
    {
      "$ref": "task.schema.json"
    },
    {
      "$ref": "assumption.schema.json"
    },
    {
      "$ref": "sensor.schema.json"
    },
    {
      "$ref": "playbook.schema.json"
    },
    {
      "$ref": "decision.schema.json"
    }
  ]
